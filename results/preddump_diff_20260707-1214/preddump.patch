+def _write_predictions_jsonl(cell_dir: Path, predictions: dict):
+    """
+    Writes predictions.jsonl (sample_id / y_true / y_pred / logits, one JSON
+    object per line, sample_id == the fixed test_loader iteration index —
+    test_loader is shuffle=False so this order is deterministic and shared
+    across arms/seeds for a given condition) then chmod 444. Called only
+    when --dump_predictions is on; off-path (run_grid's default) never
+    calls this function or creates cell_dir.
+    """
+    cell_dir.mkdir(parents=True, exist_ok=True)
+    path = cell_dir / "predictions.jsonl"
+    y_true = predictions["y_true"]
+    y_pred = predictions["y_pred"]
+    logits = predictions["logits"]
+    with open(path, "w") as f:
+        for i in range(len(y_true)):
+            row = {
+                "sample_id": i,
+                "y_true": int(y_true[i]),
+                "y_pred": int(y_pred[i]),
+                "logits": [float(v) for v in logits[i]],
+            }
+            f.write(json.dumps(row, ensure_ascii=False) + "\n")
+    os.chmod(path, stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)
+    return path
+
